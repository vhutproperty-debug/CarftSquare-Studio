# Standalone Prop/Research Browser Worker for Railway.
# Playwright image + Xvfb + x11vnc + noVNC for secure remote login.
FROM mcr.microsoft.com/playwright:v1.61.1-jammy

WORKDIR /app

# Headed Chromium on Railway needs a virtual display + VNC/noVNC gateway.
RUN apt-get update \
  && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    xvfb \
    x11vnc \
    novnc \
    websockify \
    python3 \
    python3-numpy \
  && rm -rf /var/lib/apt/lists/* \
  && (test -f /usr/share/novnc/vnc.html || test -f /usr/share/novnc/vnc_lite.html || true)

COPY package.json package-lock.json* yarn.lock* ./
RUN if [ -f yarn.lock ]; then \
      yarn install --frozen-lockfile --production=false; \
    elif [ -f package-lock.json ]; then \
      npm ci; \
    else \
      npm install; \
    fi

COPY . .

RUN chmod +x scripts/railway-browser-worker-entrypoint.sh

# Chromium is already installed in this image — do not install Firefox/WebKit.
ENV NODE_ENV=production
ENV PYTHONUNBUFFERED=1
# Do NOT set RESEARCH_CONNECT_HEADLESS / RESEARCH_BROWSER_HEADLESS here.
# Housing.com (Akamai) returns HTTP 406 to headless Chromium; defaults stay headed.

EXPOSE 4173

CMD ["bash", "scripts/railway-browser-worker-entrypoint.sh"]
