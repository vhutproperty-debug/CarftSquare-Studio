# MongoDB connection string. The app supports either MONGO_URL or MONGODB_URI.
MONGODB_URI=

# Optional database name if not included in the MongoDB URI path.
DB_NAME=

# Session signing secret used for admin authentication cookies.
AUTH_SECRET=
NEXTAUTH_SECRET=

# Optional email notification settings for lead notifications.
RESEND_API_KEY=
EMAIL_FROM=Brush & Bloom <notifications@brushandbloom.space>
EMAIL_TO=arunpandey@brushandbloom.space

# Optional WhatsApp Business API settings for admin quote messages.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Optional AI visualizer settings.
STABILITY_API_KEY=
CLARIFAI_API_KEY=
