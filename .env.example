# Copy to `.env.local` and fill in values. Restart: npm run dev

# === REQUIRED: MongoDB Atlas ===
# On Windows, prefer the direct (non-SRV) connection string from Atlas:
# Connect → Drivers → "Standard connection string"
MONGODB_URI=mongodb://USER:PASSWORD@cluster0-shard-00-00.xxxxx.mongodb.net:27017,cluster0-shard-00-01.xxxxx.mongodb.net:27017,cluster0-shard-00-02.xxxxx.mongodb.net:27017/brushandbloom?ssl=true&authSource=admin&retryWrites=true&w=majority
# DATABASE_URL=  # optional alias for MONGODB_URI (some hosts use this name)
DB_NAME=brushandbloom

# Use only ONE connection variable. Do not set MONGO_URL to localhost if you use Atlas.
# MONGO_URL=mongodb://127.0.0.1:27017

# === REQUIRED: admin session cookie signing ===
AUTH_SECRET=your-long-random-secret-here
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://craftsquare.co.in

# === Site URL & CORS (comma-separated allowed origins for cross-origin API access) ===
# Set in Vercel Production (NEXT_PUBLIC_* is exposed to the browser — do not put secrets here):
# NEXT_PUBLIC_SITE_URL=https://craftsquare.co.in
# CORS_ORIGINS=https://craftsquare.co.in,https://www.craftsquare.co.in
# NEXT_PUBLIC_SITE_DOMAIN=craftsquare.co.in

# === REQUIRED for Partner Network OTP email (Vercel Production scope + redeploy) ===
# Exact variable names — typos will break OTP in production:
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=CraftSquare Studio <notifications@craftsquare.co.in>
# Do NOT use RESEND_FROM or RESEND_EMAIL — use EMAIL_FROM exactly.
# Do NOT prefix RESEND_API_KEY with NEXT_PUBLIC_ (server-only secret).

# === Optional: legacy site email notifications ===
# EMAIL_TO=arunpandey@craftsquare.studio

# === Partner Network OTP (WhatsApp optional) ===
# PARTNER_OTP_TEST_EMAIL=your@email.com
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=

# === Legacy SMS OTP (deprecated — not used for partner login) ===
# SMS_PROVIDER=msg91
# MSG91_AUTH_KEY=
# MSG91_OTP_TEMPLATE_ID=
# MSG91_SENDER_ID=

# === Optional: analytics & AI ===
# === Google Analytics 4 (optional override — default is lib/analytics/ga-measurement-id.js) ===
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-DEHJQKSYV6
# NEXT_PUBLIC_META_PIXEL_ID=1340743388120075

# NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://www.instagram.com/craftsquare_studio/
# NEXT_PUBLIC_SOCIAL_FACEBOOK=https://www.facebook.com/profile.php?id=61590510189953
# NEXT_PUBLIC_SOCIAL_TWITTER=https://x.com/CraftSquare_St

# === Meta Conversions API (server-side only — never expose META_ACCESS_TOKEN to client) ===
# Required for server-side Lead events (Vercel Production):
# META_PIXEL_ID=1340743388120075
# META_ACCESS_TOKEN=<Meta Events Manager → Settings → Conversions API → Generate token>
#
# Optional — routes CAPI events to Test Events only (remove after verification):
# META_TEST_EVENT_CODE=TEST49453
#
# Browser Pixel ID (client-side, production only):
# NEXT_PUBLIC_META_PIXEL_ID=1340743388120075
#
# Validation:
# - CAPI skips silently when META_ACCESS_TOKEN is missing (users unaffected).
# - Lead events fire only after successful form submission via trackLeadFromSource().
# - Browser Pixel + CAPI share the same event_id for deduplication.
# - PII (phone, email, name) is SHA-256 hashed server-side before sending to Meta.
# NEXT_PUBLIC_GOOGLE_REVIEWS_URL=https://g.page/r/YOUR_GOOGLE_BUSINESS_ID/review
# STABILITY_API_KEY=
# CLARIFAI_API_KEY=

# === AI Assisted Quotation Platform ===
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# AI_API_KEY=

# === Ops: Housing.com demand connector (server-side only) ===
# HOUSING_API_BASE_URL=https://leads.housing.com/api/v0
# HOUSING_API_PARTNER_ID=
# HOUSING_API_KEY=

# === Prop AI ↔ CraftSquare Research (Connector API machine auth) ===
# Shared secret for Prop AI to call ONLY:
#   GET  /api/connectors/v1/status
#   POST /api/connectors/v1/search
# Send as: Authorization: Bearer <key>  OR  x-prop-ai-key: <key>
# Admin session cookies continue to work for the Research UI on all routes.
# PROP_AI_API_KEY=

# === Prop/Research browser automation (server-side / long-running Node) ===
# Default is headed. Housing.com (Akamai) returns HTTP 406 "Security Alert" to headless Chromium.
# RESEARCH_BROWSER_HEADLESS=true
# RESEARCH_BROWSER_TIMEOUT_MS=45000
# RESEARCH_BROWSER_NAV_TIMEOUT_MS=60000
# RESEARCH_BROWSER_POOL_SIZE=2
# RESEARCH_BROWSER_RETRIES=2
# Writable roots for Chromium profiles / screenshots (required on read-only hosts).
# Defaults to OS temp (never /var/task). On Railway you can set a volume path:
# RESEARCH_BROWSER_PROFILE_ROOT=/tmp/craftsquare/research-profiles
# RESEARCH_BROWSER_SCREENSHOT_ROOT=/tmp/craftsquare/research-screenshots
# RESEARCH_SESSION_TTL_MS=
# RESEARCH_ENCRYPTION_KEY=
# RESEARCH_MONITOR_CRON_SECRET=  # optional header x-research-monitor-secret for /api/research/scheduler/tick

# === Prop/Research remote browser connect (browser worker — not Next.js) ===
# RESEARCH_BROWSER_PROVIDER=self_hosted   # self_hosted | browserless | browserbase | docker_worker
# RESEARCH_BROWSER_WORKER_PORT=4173
# RESEARCH_BROWSER_WORKER_URL=http://127.0.0.1:4173
# Public HTTPS origin of the Railway worker (used in signed noVNC links).
# RESEARCH_BROWSER_WORKER_PUBLIC_URL=https://unique-endurance-production-57a8.up.railway.app
# Optional dedicated secret for signing remote-view URLs (falls back to AUTH_SECRET).
# RESEARCH_REMOTE_VIEW_SECRET=
# RESEARCH_CONNECT_HEADLESS=false         # true = headless + screenshot stream only
# WARNING: RESEARCH_CONNECT_HEADLESS=true makes Housing.com return HTTP 406 (Akamai).
# On Railway, keep this unset/false; remote login uses per-session Xvfb + noVNC.
# RESEARCH_CONNECT_TIMEOUT_MS=720000
# RESEARCH_SESSION_VALIDATE_MS=10800000   # auto-validate interval (default 3h)
# Operational hardening (worker boot scavenger / retention / heartbeat)
# RESEARCH_PROTOCOL_VERSION=2.0.0         # must match worker major protocol
# RESEARCH_STALE_SESSION_MS=43200000      # mark needs_login if lastVerified older (12h)
# RESEARCH_PROFILE_SCAVENGE_MS=86400000   # orphan profile TTL (24h)
# RESEARCH_ARTIFACT_TTL_MS=172800000      # screenshots/traces TTL (48h)
# RESEARCH_CONNECT_DIR_TTL_MS=21600000    # connect preview dirs TTL (6h)
# RESEARCH_BROWSERLESS_WS=
# RESEARCH_BROWSERLESS_LIVE_URL=
# RESEARCH_BROWSERBASE_WS=
# RESEARCH_BROWSERBASE_LIVE_URL=
# Vercel Production: RESEARCH_BROWSER_WORKER_URL must point at the Railway worker HTTPS URL.
