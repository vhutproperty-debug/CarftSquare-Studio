# Copy to `.env.local` and fill in values. Restart: npm run dev

# === REQUIRED: MongoDB Atlas ===
# On Windows, prefer the direct (non-SRV) connection string from Atlas:
# Connect → Drivers → "Standard connection string"
MONGODB_URI=mongodb://USER:PASSWORD@cluster0-shard-00-00.xxxxx.mongodb.net:27017,cluster0-shard-00-01.xxxxx.mongodb.net:27017,cluster0-shard-00-02.xxxxx.mongodb.net:27017/brushandbloom?ssl=true&authSource=admin&retryWrites=true&w=majority
# DATABASE_URL=  # optional alias for MONGODB_URI (some hosts use this name)
DB_NAME=brushandbloom

# Use only ONE connection variable. Do not set MONGO_URL to localhost if you use Atlas.
# MONGO_URL=mongodb://127.0.0.1:27017

# === REQUIRED: admin session cookie signing ===
AUTH_SECRET=your-long-random-secret-here
NEXTAUTH_SECRET=
# Production only — set in Vercel with "Production" scope checked, then redeploy:
NEXTAUTH_URL=https://craftsquare.studio

# === Site URL & CORS (comma-separated allowed origins for cross-origin API access) ===
# Set in Vercel Production (NEXT_PUBLIC_* is exposed to the browser — do not put secrets here):
NEXT_PUBLIC_SITE_URL=https://craftsquare.studio
# CORS_ORIGINS=https://craftsquare.studio,https://www.craftsquare.studio
# NEXT_PUBLIC_SITE_DOMAIN=craftsquare.studio

# === REQUIRED for Partner Network OTP email (Vercel Production scope + redeploy) ===
# Exact variable names — typos will break OTP in production:
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=CraftSquare Studio <notifications@craftsquare.co.in>
# Do NOT use RESEND_FROM or RESEND_EMAIL — use EMAIL_FROM exactly.
# Do NOT prefix RESEND_API_KEY with NEXT_PUBLIC_ (server-only secret).

# === Optional: legacy site email notifications ===
# EMAIL_TO=arunpandey@craftsquare.studio

# === Partner Network OTP (WhatsApp optional) ===
# PARTNER_OTP_TEST_EMAIL=your@email.com
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=

# === Legacy SMS OTP (deprecated — not used for partner login) ===
# SMS_PROVIDER=msg91
# MSG91_AUTH_KEY=
# MSG91_OTP_TEMPLATE_ID=
# MSG91_SENDER_ID=

# === Optional: analytics & AI ===
# === Google Analytics 4 (optional override — default is lib/analytics/ga-measurement-id.js) ===
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-DEHJQKSYV6
# NEXT_PUBLIC_META_PIXEL_ID=1035997402200452

# NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://www.instagram.com/craftsquare_studio/
# NEXT_PUBLIC_SOCIAL_FACEBOOK=https://www.facebook.com/profile.php?id=61590510189953
# NEXT_PUBLIC_SOCIAL_TWITTER=https://x.com/CraftSquare_St

# === Meta Conversions API (server-side only — never expose META_ACCESS_TOKEN to client) ===
# META_PIXEL_ID=1035997402200452
# META_ACCESS_TOKEN=
# META_TEST_EVENT_CODE=
# NEXT_PUBLIC_GOOGLE_REVIEWS_URL=https://g.page/r/YOUR_GOOGLE_BUSINESS_ID/review
# STABILITY_API_KEY=
# CLARIFAI_API_KEY=

# === AI Assisted Quotation Platform ===
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# AI_API_KEY=
