# Copy to `.env.local` and fill in values. Restart: npm run dev

# === REQUIRED: MongoDB Atlas ===
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/brushandbloom?retryWrites=true&w=majority
DB_NAME=brushandbloom

# Use only ONE connection variable. Do not set MONGO_URL to localhost if you use Atlas.
# MONGO_URL=mongodb://127.0.0.1:27017

# === REQUIRED: admin session cookie signing ===
AUTH_SECRET=your-long-random-secret-here

# === Optional ===
# RESEND_API_KEY=
# EMAIL_FROM=Brush & Bloom <notifications@brushandbloom.space>
# EMAIL_TO=arunpandey@brushandbloom.space
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
